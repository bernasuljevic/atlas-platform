<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Test projesi kendi wwwroot/Views arayışına girmesin - sadece Atlas.Api'nin
         WebApplicationFactory ile ayağa kaldırılması için Sdk.Web şart. -->
    <GenerateEmbeddedFilesManifest>false</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- xunit.runner.json: BULUNAN GERÇEK BUG (Test & CI sertleştirme Gün 2,
       2026-08-12, GitHub Actions'a taşınınca ORTAYA ÇIKTI) - xUnit
       varsayılan olarak test SINIFLARINI paralel çalıştırır. Her sınıf
       kendi AtlasApiFactory'sini (WebApplicationFactory) ayağa kaldırıyor,
       her biri Program.cs'in TAMAMINI (dolayısıyla VaultDbContext'in gerçek
       SQL Server migration'ını - Vault BİLEREK InMemory'e çevrilmiyor)
       çalıştırıyor. Yerel geliştirmede bu hiç sorun ÇIKARMADI çünkü
       "AtlasPlatform" veritabanı zaten HAFTALARDIR var (native dev'den) -
       Migrate() idempotent, sadece eksik migration'ları uygular. AMA CI'da
       (Gün 2) veritabanı HER ÇALIŞTIRMADA SIFIRDAN - birden fazla test
       sınıfı AYNI ANDA "veritabanı yok, oluşturayım" durumuna düşüp
       "CREATE DATABASE" için YARIŞTI, biri kazanıp diğerleri "Database
       'AtlasPlatform' already exists" hatasıyla patladı (canlı, gerçek bir
       GitHub Actions çalıştırmasında yakalandı). Çözüm: test SINIFLARININ
       paralel çalışmasını KAPAT - bu hem yarışı ortadan kaldırıyor hem de
       zaten paylaşılan gerçek dış kaynaklara (Postgres/SQL Server) karşı
       çalışan testler için daha güvenli/öngörülebilir bir varsayım. -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Host\Atlas.Api\Atlas.Api.csproj" />
  </ItemGroup>

</Project>
